{
  "name": "project-template",
  "version": "1.0.0",
  "description": "Capstone Project Template ",
  "repository": {
    "type": "git",
    "url": "https://autocode.git.epam.com/campus_javascript/capstone-project/project-template.git"
  },
  "license": "ISC",
  "author": "Rostyslav Hasiuk",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "npm run compile",
    "compile": "npm run compile:styles && npm run compile:scripts",
    "compile:styles": "sass --no-source-map src/scss:dist/css",
    "compile:scripts": "tsc",
    "watch": "concurrently --names sass,tsc \"npm run watch:styles\" \"npm run watch:scripts\"",
    "watch:styles": "sass --no-source-map --watch src/scss:dist/css",
    "watch:scripts": "tsc --watch --preserveWatchOutput",
    "serve": "browser-sync start --server --startPath src/index.html --files \"src/**/*.html\" \"dist/css/**/*.css\" \"dist/js/**/*.js\"",
    "dev": "npm run compile:styles && concurrently --names sass,tsc,server \"npm run watch:styles\" \"npm run watch:scripts\" \"npm run serve\"",
    "lint": "npm run lint:scripts && npm run lint:styles",
    "lint:scripts": "tsc && eslint .",
    "lint:styles": "stylelint \"src/scss/**/*.scss\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "sass": "^1.108.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^7.0.2"
  }
}